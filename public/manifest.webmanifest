{
  "name": "Aurum \u2014 Where every page is treasured",
  "short_name": "Aurum",
  "description": "A premium offline-first e-reader for EPUB and PDF books.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0b0b0a",
  "theme_color": "#0b0b0a",
  "categories": [
    "books",
    "education",
    "productivity"
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Library",
      "url": "/"
    },
    {
      "name": "Annotations",
      "url": "/notes"
    },
    {
      "name": "Reading stats",
      "url": "/stats"
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "application/epub+zip": [
          ".epub"
        ],
        "application/pdf": [
          ".pdf"
        ],
        "application/vnd.comicbook+zip": [
          ".cbz"
        ],
        "text/plain": [
          ".txt"
        ]
      }
    }
  ]
}