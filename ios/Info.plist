			<array>
				<string>public.zip-archive</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>cbz</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.comicbook+zip</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Aurum uses the camera so you can take a photo for a book cover, and, if you turn on "Cover on front screen", to show the book cover on iPhone Duo's front screen while you read. Nothing is recorded.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Aurum saves images you export to your photo library.</string>
